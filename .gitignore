# ─────────────────────────────────────────────────────────────
#  HID Remote · .gitignore
# ─────────────────────────────────────────────────────────────

# ── Secrets & signing (NEVER commit these) ───────────────────
keystore.properties
*.jks
*.keystore
*.p12
*.pem
.env
.env.*
google-services.json
local.properties
secrets.properties

# ── Build output ────────────────────────────────────────────
build/
/app/build/
/captures/
.externalNativeBuild/
.cxx/
# Build APKs stay out; the published APK in /release/ is committed on purpose.
# (Files over 100 MB are blocked by .githooks/pre-commit and the CI size check.)
*.apk
!/release/*.apk
*.aab
*.ap_
*.dex
*.class
output-metadata.json

# ── Gradle ──────────────────────────────────────────────────
.gradle/
.kotlin/
!gradle/wrapper/gradle-wrapper.jar

# ── Android Studio / IntelliJ ───────────────────────────────
*.iml
*.ipr
*.iws
.idea/
.navigation/
out/

# ── VS Code & other editors ─────────────────────────────────
.vscode/
*.swp
*~
.project
.classpath
.settings/

# ── Logs, crash dumps & profiling ───────────────────────────
*.log
*.hprof
hs_err_pid*
replay_pid*

# ── Test & screenshot tooling scratch ───────────────────────
/app/build/outputs/roborazzi/
*_compare.png
*_actual.png

# ── OS junk ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ── Leftovers from the AI Studio template ───────────────────
/public/
metadata.json
.env.example
